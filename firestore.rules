rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAuthenticatedEmail() {
      return isSignedIn() && request.auth.token.email is string;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /sharedActivities/{activityId} {
      function isMember(data) {
        return hasAuthenticatedEmail()
          && data.memberEmails is list
          && request.auth.token.email in data.memberEmails;
      }

      function validActivity(data) {
        return data.keys().hasOnly([
            'title', 'destination', 'ownerUid', 'memberEmails',
            'memberNames', 'createdAt', 'updatedAt'
          ])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.destination is string
          && data.destination.size() <= 100
          && data.ownerUid is string
          && data.memberEmails is list
          && data.memberEmails.size() > 0
          && data.memberEmails.size() <= 40
          && data.memberNames is map
          && data.updatedAt == request.time;
      }

      allow get: if isMember(resource.data);
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if hasAuthenticatedEmail()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.token.email in request.resource.data.memberEmails
        && request.resource.data.createdAt == request.time
        && validActivity(request.resource.data);
      allow update: if isMember(resource.data)
        && validActivity(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.memberEmails.hasAll(resource.data.memberEmails)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'destination', 'memberEmails', 'updatedAt'
        ]);
      allow delete: if isMember(resource.data) && resource.data.ownerUid == request.auth.uid;

      match /items/{itemId} {
        function parentActivity() {
          return get(/databases/$(database)/documents/sharedActivities/$(activityId)).data;
        }

        function canAccessParent() {
          return isMember(parentActivity());
        }

        function validItem(data) {
          return data.keys().hasOnly([
              'title', 'date', 'time', 'location', 'notes',
              'createdBy', 'createdAt', 'updatedAt', 'updatedBy'
            ])
            && data.title is string
            && data.title.size() > 0
            && data.title.size() <= 120
            && data.date is string
            && data.time is string
            && data.location is string
            && data.location.size() <= 200
            && data.notes is string
            && data.notes.size() <= 2000;
        }

        allow read: if canAccessParent();
        allow create: if canAccessParent()
          && request.resource.data.createdBy == request.auth.token.email
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && validItem(request.resource.data);
        allow update: if canAccessParent()
          && validItem(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'date', 'time', 'location', 'notes', 'updatedAt', 'updatedBy'
          ]);
        allow delete: if canAccessParent();
      }
    }

    match /sharedActivityMemberships/{membershipId} {
      function parentPath(data) {
        return /databases/$(database)/documents/sharedActivities/$(data.activityId);
      }

      function validMembership(data) {
        return data.keys().hasOnly(['activityId', 'memberEmail'])
          && data.activityId is string
          && data.memberEmail is string
          && data.memberEmail.size() > 0
          && data.memberEmail.size() <= 320;
      }

      function canLinkMembership(data, parentData) {
        return hasAuthenticatedEmail()
          && parentData.memberEmails is list
          && request.auth.token.email in parentData.memberEmails
          && data.memberEmail in parentData.memberEmails;
      }

      allow get: if hasAuthenticatedEmail()
        && (resource.data.memberEmail == request.auth.token.email
          || request.auth.token.email in get(parentPath(resource.data)).data.memberEmails);
      allow list: if hasAuthenticatedEmail()
        && resource.data.memberEmail == request.auth.token.email;
      allow create: if validMembership(request.resource.data)
        && canLinkMembership(request.resource.data, getAfter(parentPath(request.resource.data)).data);
      allow update: if validMembership(request.resource.data)
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.memberEmail == resource.data.memberEmail
        && canLinkMembership(request.resource.data, getAfter(parentPath(request.resource.data)).data);
      allow delete: if false;
    }

    match /chats/{chatId} {
      function isParticipant(data) {
        return hasAuthenticatedEmail()
          && data.participants is list
          && request.auth.token.email in data.participants;
      }

      function isValidChat(data) {
        return data.keys().hasOnly(['participants', 'lastMessage', 'updatedAt'])
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1]
          && data.lastMessage is string
          && data.lastMessage.size() > 0
          && data.lastMessage.size() <= 4000
          && data.updatedAt == request.time;
      }

      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data)
        && isValidChat(request.resource.data);
      allow update: if isParticipant(resource.data)
        && isParticipant(request.resource.data)
        && request.resource.data.participants == resource.data.participants
        && isValidChat(request.resource.data);
      allow delete: if isParticipant(resource.data);

      match /messages/{messageId} {
        function chatPath() {
          return /databases/$(database)/documents/chats/$(chatId);
        }

        function canReadChat() {
          return hasAuthenticatedEmail()
            && request.auth.token.email in get(chatPath()).data.participants;
        }

        function canWriteChatAfterCommit() {
          return hasAuthenticatedEmail()
            && request.auth.token.email in getAfter(chatPath()).data.participants;
        }

        function isValidMessage() {
          return request.resource.data.keys().hasOnly(['text', 'sender', 'createdAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.sender == request.auth.token.email
            && request.resource.data.createdAt == request.time;
        }

        allow read: if canReadChat();
        allow create: if canWriteChatAfterCommit() && isValidMessage();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
