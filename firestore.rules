rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAuthenticatedEmail() {
      return isSignedIn() && request.auth.token.email is string;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      function isParticipant(data) {
        return hasAuthenticatedEmail()
          && data.participants is list
          && request.auth.token.email in data.participants;
      }

      function isValidChat(data) {
        return data.keys().hasOnly(['participants', 'lastMessage', 'updatedAt'])
          && data.participants is list
          && data.participants.size() == 2
          && data.participants[0] is string
          && data.participants[1] is string
          && data.participants[0] != data.participants[1]
          && data.lastMessage is string
          && data.lastMessage.size() > 0
          && data.lastMessage.size() <= 4000
          && data.updatedAt == request.time;
      }

      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data)
        && isValidChat(request.resource.data);
      allow update: if isParticipant(resource.data)
        && isParticipant(request.resource.data)
        && request.resource.data.participants == resource.data.participants
        && isValidChat(request.resource.data);
      allow delete: if isParticipant(resource.data);

      match /messages/{messageId} {
        function chatPath() {
          return /databases/$(database)/documents/chats/$(chatId);
        }

        function canReadChat() {
          return hasAuthenticatedEmail()
            && request.auth.token.email in get(chatPath()).data.participants;
        }

        function canWriteChatAfterCommit() {
          return hasAuthenticatedEmail()
            && request.auth.token.email in getAfter(chatPath()).data.participants;
        }

        function isValidMessage() {
          return request.resource.data.keys().hasOnly(['text', 'sender', 'createdAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.sender == request.auth.token.email
            && request.resource.data.createdAt == request.time;
        }

        allow read: if canReadChat();
        allow create: if canWriteChatAfterCommit() && isValidMessage();
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
